; APP.5 twin (no OCaml suite case): the everyday Text conversions and queries
; the four applications reach compile natively with the interpreter's exact
; contracts: to-int/to-real follow the reader's numeric atom grammar (sign,
; leading zeros, 63-bit overflow -> none, reals rejected by to-int and accepted
; by to-real, Scheme non-finite spellings), contains? with empty needle and
; multibyte text, codepoint-indexed clamped slice, and from-real using the
; printer's shortest round-trip spelling. The printed tuple is the guarantee.
(tuple
  (app (var list.map)
    (app (var cons) (lit "42")
      (app (var cons) (lit "+7")
        (app (var cons) (lit "-0")
          (app (var cons) (lit "007")
            (app (var cons) (lit "4611686018427387903")
              (app (var cons) (lit "4611686018427387904")
                (app (var cons) (lit "-4611686018427387904")
                  (app (var cons) (lit "-4611686018427387905")
                    (app (var cons) (lit "1.5")
                      (app (var cons) (lit "1e3")
                        (app (var cons) (lit "")
                          (app (var cons) (lit " 42")
                            (app (var cons) (lit "12a")
                              (app (var cons) (lit "+inf.0")
                                (app (var cons) (lit "1_0") (var nil))))))))))))))))
    (var text.to-int))
  (app (var list.map)
    (app (var cons) (lit "1.5")
      (app (var cons) (lit "1.")
        (app (var cons) (lit "1e3")
          (app (var cons) (lit "-2.5E-1")
            (app (var cons) (lit "42")
              (app (var cons) (lit "+inf.0")
                (app (var cons) (lit "-inf.0")
                  (app (var cons) (lit "-nan.0")
                    (app (var cons) (lit ".5")
                      (app (var cons) (lit "abc")
                        (app (var cons) (lit "4611686018427387904") (var nil))))))))))))
    (var text.to-real))
  (tuple
    (app (var text.contains?) (lit "hello") (lit "ell"))
    (app (var text.contains?) (lit "hello") (lit ""))
    (app (var text.contains?) (lit "") (lit "x"))
    (app (var text.contains?) (lit "日本語") (lit "本"))
    (app (var text.contains?) (lit "abc") (lit "abcd")))
  (tuple
    (app (var text.slice) (lit "héllo") (lit 1) (lit 3))
    (app (var text.slice) (lit "héllo") (lit -1) (lit 99))
    (app (var text.slice) (lit "héllo") (lit 3) (lit 1))
    (app (var text.slice) (lit "") (lit 0) (lit 1))
    (app (var text.slice) (lit "日本語") (lit 1) (lit 2)))
  (app (var list.map)
    (app (var cons) (lit 1.5)
      (app (var cons) (lit 1.0)
        (app (var cons) (lit 0.1)
          (app (var cons) (lit 1e21)
            (app (var cons) (lit -0.0)
              (app (var cons) (lit 3.14159265358979)
                (app (var cons) (lit 0.30000000000000004) (var nil))))))))
    (var text.from-real)))
